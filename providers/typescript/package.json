{
  "name": "liquid-provider-reference-ts",
  "version": "0.1.0",
  "description": "A reference Liquid Inference provider agent for one text deployment, in TypeScript",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "npm run build && node dist/main.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
